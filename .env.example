# MySQL Database Connection String for Grehasoft PMS/CRM NestJS Backend
DATABASE_URL="mysql://username:password@127.0.0.1:3307/grehasoft_pms_db"

# JWT Secret Key
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRATION="1d"

# App & Encryption Config
PORT=3000
SECRET_KEY="your-encryption-secret-key-here"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_HOST_USER="your-email@example.com"
EMAIL_HOST_PASSWORD="your-gmail-app-password-here"
DEFAULT_FROM_EMAIL="Grehasoft PMS <noreply@grehasoft.com>"
